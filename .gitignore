venv/
.venv/
env/
ENV/
backend/venv/
simulator/venv/

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend builds
dist/
build/
.vite/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs / local databases
*.log
*.sqlite
*.sqlite3
*.db

# Generated documents/media
*.pdf
*.docx
*.xlsx
*.csv
*.ogg
*.mp3
*.mp4
*.wav
*.mov

# Installers / archives
*.exe
*.zip

# Backup files
*.bak
*.backup
*.old
*.tmp
*.ai-backup
*.reports-backup
*.reports-pass2-backup
*.devices-backup

# Common accidental backup/source suffixes
*.before_*
*_backup_*
*_BACKUP.*
*.bak_*

